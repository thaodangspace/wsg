{
  "name": "wsg",
  "version": "0.1.0",
  "description": "Workspace assembler for coding agents",
  "type": "module",
  "bin": {
    "wsg": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:package": "node scripts/package-smoke.mjs",
    "trial:live": "node scripts/live-trial.ts"
  },
  "dependencies": {
    "@earendil-works/pi-tui": "^1.0.4",
    "typebox": "1.3.27",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2"
  },
  "optionalDependencies": {
    "@earendil-works/chord": "1.0.2",
    "@earendil-works/pi-ai": "1.0.2",
    "@earendil-works/pi-durable": "1.0.2"
  }
}
